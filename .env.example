NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CRM_SECRET_WASHCARE=
CRM_SECRET_LUX=
CRM_SECRET_BIHUB=
CRON_SECRET=

# Apply by email (project 2)
# 32 random bytes, base64. Locks the Gmail app password. Make one: openssl rand -base64 32
MAIL_ENCRYPTION_KEY=
# Shared with the GitHub "Apply tick" workflow, which calls /api/jobs/tick every hour.
AUTOMATION_SECRET=

# AI for the "why this company" lines. Optional: with none set, the app uses plain rules for free.
# On Vercel, AI Gateway signs in by itself (OIDC) and gives $5 free credit a month.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-5.5
# A free provider, tried before the Gateway. Any OpenAI-style endpoint. See docs/guides/apply-setup.md.
FREE_AI_BASE_URL=
FREE_AI_API_KEY=
FREE_AI_MODEL=

# Local testing only: save each email as an .eml file here instead of sending it.
MAIL_DROP_DIR=
