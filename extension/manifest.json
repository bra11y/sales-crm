{
  "manifest_version": 3,
  "name": "Sales CRM Apply",
  "version": "1.0.0",
  "description": "Fills job application forms from your Sales CRM profile. You always press Submit yourself.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fill this application",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://sales-crm-virid-ten.vercel.app/*",
    "http://localhost:3100/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://apply.workable.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.breezy.hr/*",
    "https://*.recruitee.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
