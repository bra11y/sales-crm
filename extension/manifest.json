{
  "manifest_version": 3,
  "name": "Sales CRM Apply",
  "version": "1.4.0",
  "description": "Follows a job application from the CRM to the thank-you page, and checks your writing in any text box when you ask. You always press Submit yourself.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sales CRM Apply",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://sales-crm-virid-ten.vercel.app/*",
    "http://localhost:3100/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sales-crm-virid-ten.vercel.app/*",
        "http://localhost:3100/*"
      ],
      "js": [
        "crm-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "check-writing": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Check the writing in the box you are typing in"
    }
  }
}
